{
  "name": "play-the-pc",
  "version": "0.1.0",
  "description": "初めてPCに触れる子ども向けのPC操作を楽しめるMac専用デスクトップアプリ",
  "main": "src/main/main.js",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "vitest run",
    "test:smoke": "vitest run test/renderer.smoke.test.js",
    "dist:mac": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0",
    "playwright": "^1.47.0",
    "vitest": "^2.1.0"
  },
  "build": {
    "appId": "com.createsekai.playthepc",
    "productName": "PCであそぼう",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.kids",
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64", "x64"]
        },
        {
          "target": "zip",
          "arch": ["arm64", "x64"]
        }
      ]
    }
  }
}
