{
  "name": "play-the-pc",
  "version": "0.1.0",
  "description": "初めてPCに触れる子ども向けの、ポインターで遊ぶMac専用デスクトップアプリ",
  "private": true,
  "main": "dist/main/main.js",
  "type": "commonjs",
  "scripts": {
    "clean": "rm -rf dist",
    "build:ts": "tsc -p tsconfig.main.json && tsc -p tsconfig.renderer.json",
    "build:assets": "node scripts/copy-assets.mjs",
    "build": "npm run clean && npm run build:ts && npm run build:assets",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "start": "npm run build && electron .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && node --test tests/e2e/renderer.e2e.mjs",
    "test:smoke": "npm run build && PLAY_PC_SMOKE_EXIT_MS=5000 electron .",
    "dist": "npm run build && electron-builder --mac"
  },
  "keywords": [
    "kids",
    "electron",
    "macos",
    "trackpad"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.2",
    "electron": "^43.2.0",
    "electron-builder": "^25.1.8",
    "playwright": "^1.56.0",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  }
}
